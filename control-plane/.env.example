# Asterism Control Plane environment template. No real secrets belong here.
NODE_ENV=development
# Compose-only database secret. Generate a random value; never commit the .env file.
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Non-secret bootstrap metadata used by the admin-create tool profile.
OWNER_EMAIL=owner@example.com
OWNER_DISPLAY_NAME=Asterism Owner
DATABASE_URL=postgres://asterism:asterism@127.0.0.1:55432/asterism_cp
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Nodes are told to reach the Control Plane at this URL. https:// outside development.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Exact comma-separated browser origins. Wildcards are rejected by design.
ALLOWED_ORIGINS=http://127.0.0.1:8080
# Phase G compatibility is deprecated and off by default in production.
OPERATOR_COMPATIBILITY=false
# Required only when compatibility mode is explicitly enabled.
ASTERISM_OPERATOR_TOKEN=
# Loopback-only development shortcut; refused in production.
ALLOW_PLAINTEXT=true
TRUST_PROXY=false
SESSION_IDLE_TIMEOUT_MS=28800000
SESSION_ABSOLUTE_TIMEOUT_MS=604800000
LOGIN_WINDOW_MS=900000
LOGIN_ACCOUNT_LIMIT=5
LOGIN_SOURCE_LIMIT=20
ENROLLMENT_TOKEN_TTL_MS=3600000
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_MISSED_LIMIT=3
HANDSHAKE_TIMEOUT_MS=10000
MAX_FRAME_BYTES=1048576
MAX_COMMAND_PAYLOAD_BYTES=131072
COMMAND_TIMEOUT_MS=600000
EVENT_BATCH_SIZE=200
MAX_CONNECTIONS=256
LOG_LEVEL=info

# Template for the production env file. No real value belongs in this repository.
#
# Copy to a path outside the git checkout — the deployed staging host uses
# /etc/asterism/control-plane.production.env — and give it mode 0600, owner root.
# It supplies the environment-specific inputs the tracked production overlay
# interpolates; every one of them is mandatory and a missing one stops the
# deployment rather than falling back to a development value.
#
#   docker compose \
#     -f docker-compose.yml \
#     -f docker-compose.production.yml \
#     --env-file .env \
#     --env-file /etc/asterism/control-plane.production.env \
#     up -d
#
# The database secret stays in the deploy directory's own `.env`, which is also
# untracked; keeping the two files separate means this one holds no secret and
# can be read while diagnosing a deployment.

# The address operators and Nodes use. Must be https.
PUBLIC_BASE_URL=https://control-plane.example.test

# Exact browser origins, comma separated. Wildcards are rejected by design, and
# PUBLIC_BASE_URL must appear here or the console is refused at its own address.
# List a second entry only for an endpoint deliberately kept for compatibility.
ALLOWED_ORIGINS=https://control-plane.example.test

# The address of the single local reverse-proxy hop, as seen by the container.
# Not `true`: trusting every hop lets any client claim any source address and
# defeats the per-source login limit. For a Compose deployment behind nginx on
# the host, this is the gateway of the network the container is attached to —
# `docker network inspect <project>_edge --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'`.
TRUST_PROXY=172.21.0.1
